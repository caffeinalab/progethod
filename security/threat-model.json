              }
            },
            "visible": true,
            "shape": "process",
            "id": "a9782b16-9a0a-46db-a343-633296aaaaca",
            "zIndex": 2,
            "data": {
              "type": "tm.Process",
              "name": "Progethod SPA",
              "description": "Nuxt 4 static SPA running in the user's browser. Holds the Wethod session token and integration tokens in Pinia (persisted to localStorage).",
              "outOfScope": false,
              "reasonOutOfScope": "",
              "threats": [
                {
                  "id": "d2d0227f-f3b7-44d8-a449-e301c6d58d33",
                  "title": "XSS steals Wethod session token from localStorage",
                  "status": "Open",
                  "severity": "High",
                  "type": "Information disclosure",
                  "description": "The Wethod SF6SESSID token and Jira/GitLab tokens live in localStorage; any XSS exfiltrates them. Alert.vue renders `message` via v-html, and some messages interpolate Wethod error text and user-defined project names.",
                  "mitigation": "Vue text interpolation escapes everything else (including leave rows built from planning data). Open: escape interpolated values or drop v-html in Alert.vue; add a CSP.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 1,
                  "score": ""
                },
                {
                  "id": "24c09cc0-73ec-489f-b2ff-4457025b21ef",
                  "title": "Expired Wethod session causes partial or confusing writes",
                  "status": "Mitigated",
                  "severity": "Low",
                  "type": "Tampering",
                  "description": "Timesheet batch posts can hit a 401 mid-run, leaving some areas written and others not.",
                  "mitigation": "useApi and useTimesheetBatchPost invalidate the token on 401 (HTTP or Wethod `code`) and show one session-expired alert. Entries are only marked synced per successful POST, so the user can re-login and resubmit.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 2,
                  "score": ""
                },
                {
                  "id": "295fbc26-82b8-486f-9dda-999ac3335e5d",
                  "title": "User submits leave hours manually on top of Wethod's automatic ones",
                  "status": "Mitigated",
                  "severity": "Low",
                  "type": "Tampering",
                  "description": "Leave projects 83/90 are filled automatically by Wethod; manual entries would double count.",
                  "mitigation": "Leave is shown as read-only LeaveEntryRow rows built from planning data, never stored as entries, so submit/reset never send them; Wethod also marks those projects is_timesheet_automatic.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 3,
                  "score": ""
                }
              ],
              "hasOpenThreats": true,
              "handlesCardPayment": false,
              "handlesGoodsOrServices": false,
              "isWebApplication": true,
              "privilegeLevel": "low"
            }
          },
          {
            "position": {
              "x": 320,
              "y": 40
            },
            "size": {
              "width": 140,
              "height": 140
            },
            "attrs": {
              "text": {
                "text": "Chrome extension"
              }
            },
            "visible": true,
            "shape": "process",
            "id": "439a8bab-0521-4dd5-a6ad-a4c4acd109ed",
            "zIndex": 3,
            "data": {
              "type": "tm.Process",
              "name": "Chrome extension",
              "description": "Reads the SF6SESSID cookie from wethod.com, validates it via /api/me and hands it to the SPA.",
              "outOfScope": false,
              "reasonOutOfScope": "",
              "threats": [
                {
                  "id": "af224dd1-5fc6-4a4c-a264-5b3d11a8dac6",
                  "title": "Session token leaks through the login URL",
                  "status": "Mitigated",
                  "severity": "High",
                  "type": "Information disclosure",
                  "description": "Passing the token as a query param exposes it in history, the address bar and tab previews.",
                  "mitigation": "Token handed over via a 60s Secure, SameSite=Strict first-party cookie set before opening /login; login.vue reads and deletes it, and strips the legacy ?token= param synchronously via history.replaceState.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 4,
                  "score": ""
                }
              ],
              "hasOpenThreats": false,
              "handlesCardPayment": false,
              "handlesGoodsOrServices": false,
              "isWebApplication": true,
              "privilegeLevel": "low"
            }
          },
          {
            "position": {
              "x": 640,
              "y": 280
            },
            "size": {
              "width": 140,
              "height": 140
            },
            "attrs": {
              "text": {
                "text": "Cloudflare Pages Functions"
              }
            },
            "visible": true,
            "shape": "process",
            "id": "384f6f89-7653-4bcf-91fe-d8ea53ddfd24",
            "zIndex": 4,
            "data": {
              "type": "tm.Process",
              "name": "Cloudflare Pages Functions",
              "description": "/api/* proxy to Wethod plus OAuth token exchange for Jira/GitLab and the holidays iCal proxy.",
              "outOfScope": false,
              "reasonOutOfScope": "",
              "threats": [
                {
                  "id": "0010b942-1d32-4da8-9929-e61c88445ca6",
                  "title": "Unauthenticated use of the proxy",
                  "status": "Mitigated",
                  "severity": "Medium",
                  "type": "Spoofing",
                  "description": "Anyone can call /api/*.",
                  "mitigation": "_middleware.js rejects /api requests without x-sf-sess-id (except jira-token, gitlab-token, holidays); Wethod validates the session on every proxied call.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 5,
                  "score": ""
                },
                {
                  "id": "ff681610-1bbb-45b0-9a76-589c5db7878c",
                  "title": "No rate limiting on /api endpoints",
                  "status": "Open",
                  "severity": "Low",
                  "type": "Denial of service",
                  "description": "Functions have no per-IP or per-user rate limiting; the OAuth token and holidays endpoints are unauthenticated.",
                  "mitigation": "Relies on Cloudflare platform limits and Wethod/GitLab/Atlassian upstream limits. Open: add Cloudflare rate limiting rules for /api/*-token and /api/holidays.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 6,
                  "score": ""
                },
                {
                  "id": "d87c328a-1e47-436a-aaa2-8e2b34802fe0",
                  "title": "Internal error details leaked to clients",
                  "status": "Open",
                  "severity": "Low",
                  "type": "Information disclosure",
                  "description": "The error handler returns err.message in 500 responses.",
                  "mitigation": "Messages are upstream/fetch errors, not secrets. Open: return a generic message and log details server-side.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 7,
                  "score": ""
                },
                {
                  "id": "64ac5174-8222-4f37-af68-7257c62e8b7e",
                  "title": "OAuth client secrets exposed",
                  "status": "Mitigated",
                  "severity": "High",
                  "type": "Information disclosure",
                  "description": "Jira/GitLab client secrets are needed for token exchange.",
                  "mitigation": "Secrets stay in server env vars (*_CLIENT_SECRET); the client only gets *_CLIENT_ID via runtimeConfig.public. PKCE is used for both flows.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 8,
                  "score": ""
                },
                {
                  "id": "81ab9a63-504a-4f76-9851-2844e23788a6",
                  "title": "Cross-origin calls to the API in production",
                  "status": "Mitigated",
                  "severity": "Low",
                  "type": "Spoofing",
                  "description": "Browsers on other origins could try to call /api with a stolen token header.",
                  "mitigation": "CORS Allow-Origin is only set in development; production responds without it so cross-origin reads are blocked.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 9,
                  "score": ""
                }
              ],
              "hasOpenThreats": true,
              "handlesCardPayment": false,
              "handlesGoodsOrServices": false,
              "isWebApplication": true,
              "privilegeLevel": "medium"
            }
          },
